{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "crons": [{ "path": "/api/cron-drain", "schedule": "0 14 * * *" }],
  "rewrites": [
    { "source": "/how/:rest+", "destination": "/how/index.html" },
    { "source": "/faq/:rest+", "destination": "/faq/index.html" },
    { "source": "/:chamber(house|senate)", "destination": "/index.html" },
    { "source": "/:st([A-Z]{2})/:ch(house|senate)/:rest+", "destination": "/:st/:ch/index.html" },
    { "source": "/:st([A-Z]{2})/:rest+", "destination": "/:st/index.html" },
    { "source": "/:st([a-z][a-zA-Z]|[A-Z][a-z])/:rest*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://geocoding.geo.census.gov; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
