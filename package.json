    "vitest": "^5.0.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "mapshaper": "^0.7.72",
    "shapefile": "^0.6.6",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "zod": "^4.6.5"
  }
