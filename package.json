{
  "name": "str-redistricting",
  "version": "0.1.0",
  "private": true,
  "description": "Chris Melson's redistricting algorithm: shortest splitline, deterministic, partisan-blind, reproducible by anyone.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "explore": "node --max-old-space-size=8192 --import tsx src/server/app/cli.ts",
    "publish-data": "node --max-old-space-size=8192 --import tsx src/server/app/publish.ts"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/adm-zip": "^0.5.8",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "dependency-cruiser": "^18.5.0",
    "geojson-vt": "^5.0.4",
    "jsdom": "^29.1.1",
    "pbf": "^5.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vt-pbf": "^3.1.3"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "adm-zip": "^0.6.1",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^6.11.2",
    "mapshaper": "^0.7.72",
    "pmtiles": "^4.5.0",
    "shapefile": "^0.6.6",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.5"
  }
}
