# Same headers as vercel.json, for static hosts that read a _headers file
# (the production deploy on Vercel uses vercel.json). Everything the viewer
# loads comes from this site, except one script: the answer from the U.S.
# Census Bureau address service, which only answers browsers as a script.
#
#   script-src    this site, plus the Census geocoder host for that answer
#   worker-src    this site, plus blob: for the map's drawing worker
#   style-src     this site only (the viewer sets styles through the style
#                 object, which this policy allows; no inline style blocks)
#   img-src       this site, data: and blob: (map icons, map textures)
#   connect-src   this site (the map data files); blob: for the map worker
#   frame-ancestors is left out on purpose: the viewer can be embedded.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://geocoding.geo.census.gov; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Map data keeps its name between releases, so a browser must check with the server before reusing it
# (a cheap 304 when nothing changed). Range requests for .pmtiles are unaffected.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
